+            if (x>maxx) maxx=x;
+            if (y<miny) miny=y;
+            if (y>maxy) maxy=y;
+        }
+    }
+    if (!full) {minx-=2;miny-=2;maxx+=2;maxy+=2;}
+    if (minx<0) minx=0;
+    if (miny<0) miny=0;
+    if (maxx>=UV_SIDE) maxx=UV_SIDE-1;
+    if (maxy>=UV_SIDE) maxy=UV_SIDE-1;
